#include <stdio.h>
#include <string.h>
struct Patient {
    int id;
    char name[50];
    int age;
    char disease[100];
};
void main() {
    struct Patient data[100];
    int i,n,a,choice;
    char b[10],c[10],d[10];
    printf("\n--- Hospital Management System ---\n");
    printf("Enter the number of patients for today:");
    scanf("%d",&n);
    for (int i=1;i<=n;i++){
        printf("Enter the patient ID:");
        scanf("%d" ,&data[i].id);
        printf("Enter patient name: ");
        scanf("%s", data[i].name);
        printf("Enter age: ");
        scanf("%d", &data[i].age);
        printf("Enter disease: ");
        scanf(" %s", data[i].disease);
        printf("Patient added successfully.\n");
        }
    printf("Select your role:\n");
    printf("1. Doctor\n2. Nurse\n3. Pharmacist\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    if (choice == 1) {
        char docName[50], department[50],docID;
        printf("\n--- Doctor Login ---\n");
        printf("Enter your name: ");
        scanf(" %s", docName);
        printf("Enter your ID:");
        scanf("%d", &docID);
        printf("Enter your department: ");
        scanf(" %s", department);

        printf("\nWelcome Dr. %s from %s Department\n", docName, department);
        printf("Your patients for today are:");
        if (n == 0) {
            printf("No patients available.\n");
        } else {
            for (int i = 1; i <=n; i++) {
                printf("\nPatient %d:\n", i);
                printf("ID: %d\n", data[i].id);
                printf("Name: %s\n", data[i].name);
                printf("Age: %d\n", data[i].age);
                printf("Disease: %s\n", data[i].disease);
            }
        }

    } else if (choice == 2) {
        printf("\n--- Nurse Panel ---\n");
        printf("Enter the patient vitals:\n");
       for(int i=1;i<=n;i++) {
            printf("Enter the patient ID:\n");
            scanf("%d", &a);
            if (a!=data[i].id){
                printf("Patient does not exist!!\n");
            }else{
            printf("Patient Name: %s\n", data[i].name);
            printf("Disease: %s\n", data[i].disease);
            printf("Is the patient awake?\n");
            scanf("%s", b);
            printf("Is the patient breathing?\n");
            scanf("%s", c);
            printf("Is the patient intaking food?\n");
            scanf("%s", d);
            printf("Patient details added successfully.\n");
        }
       }
    } else if (choice == 3) {
        int pid, flag = 0;
        printf("\n--- Pharmacist Panel ---\n");
        printf("Enter patient ID to view medicine: ");
        scanf("%d", &pid);

        for (int i = 1; i <= n; i++) {
            if (pid==data[i].id) {
                printf("Patient Name: %s\n", data[i].name);
                printf("Disease: %s\n", data[i].disease);
                if (strcmp(data[i].disease, "Fever") == 0) {
                    printf("Prescribed Medicine: Paracetamol\n");
                } else if (strcmp(data[i].disease, "Cold") == 0) {
                    printf("Prescribed Medicine: Cetrizine\n");
                }else if (strcmp(data[i].disease, "Cough")==0){
                    printf("Prescribed Medicine: Ascoril LS\n");
                } else {
                    printf("Prescribed Medicine: Consult Doctor\n");
                }
                flag = 1;
            }
        }

        if (flag==0) {
            printf("Patient not found.\n");
        }

    } else {
        printf("Invalid choice.\n");
}
}
